waveshare:
  ip: "192.168.1.200"    # Waveshare RS232-Eth bridge IP address
  port: 4196             # Correspondent IP port
  reconnect_delay: 5     # Seconds to wait before retrying a dropped/failed connection

mqtt:
  broker: "localhost"    # IP of Mosquitto broker on Ubuntu
  port: 1883
  username: ""           # Leave blank if no auth
  password: ""

# ID blinds
blinds:
  1 : "Example blind 1"
  2 : "Example blind 2


# ID lights
lights:
  3 : "Example light 1"
  4 : "Example light 2"
  5 : "blank"

# ID Switches
inputs:
  1 : "Example switch 1"
  2 : "Example switch 2"

mappings:
  1:
    single_press : 1
    double_press : 2
    long_press : 3
  2:
    single_press : 4
    double_press : 5
    long_press : 6

#note, if name given is "blank", the entity will be ignored